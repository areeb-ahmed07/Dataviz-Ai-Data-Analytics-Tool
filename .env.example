# ── DataViz Pro — Environment Configuration ─────────────────────
# Copy this file to .env and fill in your values.
# Never commit the real .env file (it is excluded in .gitignore).

# ── Application ────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-string
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
DEBUG=False

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=sqlite:///dataviz_pro.db

# ── File Storage ─────────────────────────────────────────────
MAX_CONTENT_LENGTH=52428800

# ── AI Features (optional) ────────────────────────────────────
OPENAI_API_KEY=

# ── OAuth (optional) ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
